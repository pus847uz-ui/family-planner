rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isFamilyMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isFamilyMember();
      allow write: if false;

      // Переписка с ИИ — единственное в базе, что закрыто от второго члена семьи:
      // задачи и покупки общие по смыслу, а вопрос «что мне сделать» — личный.
      // Условие именно uid == userId, а не isFamilyMember(), иначе историю читали бы оба.
      // Пишет и чистит только сервер через Admin SDK, поэтому запись закрыта всем.
      match /ai_conversations/{conversationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /tasks/{taskId} {
      allow read, write: if isFamilyMember();
    }

    match /shopping_items/{itemId} {
      allow read, write: if isFamilyMember();
    }

    match /events/{eventId} {
      allow read, write: if isFamilyMember();
    }

    match /budget_projects/{projectId} {
      allow read, write: if isFamilyMember();
    }

    match /budget_entries/{entryId} {
      allow read, write: if isFamilyMember();
    }

    match /recurring_payments/{paymentId} {
      allow read, write: if isFamilyMember();
    }

    // Факты оплат: по записи на каждое нажатие «Оплатил». Копятся, чтобы через несколько
    // месяцев аналитика опиралась на то, что было, а не на пересчёт сегодняшних условий.
    match /payment_records/{recordId} {
      allow read, write: if isFamilyMember();
    }

    // Курсы ЦБ на каждый день. Пишет только плановая функция через Admin SDK — курс
    // официальный, и правка его из приложения означала бы подделку истории трат.
    match /exchange_rates/{date} {
      allow read: if isFamilyMember();
      allow write: if false;
    }

    match /plans/{planId} {
      allow read, write: if isFamilyMember();
    }

    match /plan_checklist_items/{itemId} {
      allow read, write: if isFamilyMember();
    }

    match /plan_menu_items/{itemId} {
      allow read, write: if isFamilyMember();
    }

    match /plan_bookings/{bookingId} {
      allow read, write: if isFamilyMember();
    }
  }
}
